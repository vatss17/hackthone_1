# Two git-ignored files, filled in on your own machine:
#   .env.local       what the running app needs (URL, publishable key, SITE_URL)
#   .env.test.local  database/auth test credentials ONLY (secret key, DB_TESTS_ENABLED);
#                    Next.js never loads it outside NODE_ENV=test, so the app never sees the secret
# The test scripts load both files. Only this file (placeholders, no secrets) is committed.
# NEVER commit real values. NEVER paste them into chat, tickets or logs.

# ---------------------------------------------------------------------------
# Database test harness (tests/db). Targets the hosted DEVELOPMENT project only.
# ---------------------------------------------------------------------------

# [.env.local] Project URL, from Supabase dashboard > Project Settings > API.
# Must be the dev project; the harness refuses any other host.
SUPABASE_URL=https://YOUR-DEV-PROJECT-REF.supabase.co

# [.env.local] Public key (publishable key, or the legacy "anon" key). Used by the app
# (server-side only) and by the tests for all authorization assertions.
SUPABASE_PUBLISHABLE_KEY=

# [.env.test.local] PRIVILEGED key (secret key, or the legacy "service_role" key). Bypasses RLS.
# Used ONLY by tests/db/lib/admin.mjs for test-user setup and cleanup.
# Server/test use only: never prefix with NEXT_PUBLIC_, never import in app code.
SUPABASE_SECRET_KEY=

# [.env.test.local] Safety switch: tests do nothing unless this is exactly 1.
DB_TESTS_ENABLED=0

# ---------------------------------------------------------------------------
# Application authentication (M1.3C). Read ONLY by server code, never sent to the browser.
# ---------------------------------------------------------------------------
# The app reads only SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY (from .env.local). It never
# reads SUPABASE_SECRET_KEY, which lives in .env.test.local.

# Public origin used in confirmation-email links. Defaults to http://localhost:3000 in
# development; REQUIRED in production. It must also be allowed in Supabase under
# Authentication > URL Configuration (Site URL and Redirect URLs).
# SITE_URL=http://localhost:3000
