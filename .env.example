# Copy to .env.local (git-ignored) and fill in on your own machine.
# NEVER commit real values. NEVER paste them into chat, tickets or logs.
# Only this file (placeholders, no secrets) is committed.

# ---------------------------------------------------------------------------
# Database test harness (tests/db). Targets the hosted DEVELOPMENT project only.
# ---------------------------------------------------------------------------

# Project URL, from Supabase dashboard > Project Settings > API.
# Must be the dev project; the harness refuses any other host.
SUPABASE_URL=https://YOUR-DEV-PROJECT-REF.supabase.co

# Public key (publishable key, or the legacy "anon" key). Safe for browsers,
# used for all authorization assertions together with each test user's session.
SUPABASE_PUBLISHABLE_KEY=

# PRIVILEGED key (secret key, or the legacy "service_role" key). Bypasses RLS.
# Used ONLY by tests/db/lib/admin.mjs for test-user setup and cleanup.
# Server/test use only: never prefix with NEXT_PUBLIC_, never import in app code.
SUPABASE_SECRET_KEY=

# Safety switch: tests do nothing unless this is exactly 1.
DB_TESTS_ENABLED=0

# ---------------------------------------------------------------------------
# Application (not used until M1.3C; listed so the names are agreed early)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
